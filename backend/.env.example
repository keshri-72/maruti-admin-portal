# ── Maruti Admin Portal — Backend ───────────────────────────────────────────
# Copy to .env and fill in values.

# App
SECRET_KEY=change-this-to-a-long-random-secret-key-min-32-chars
APP_ENV=development
DEBUG=true

# Database (SQLite by default — zero infrastructure needed)
# SQLite:     sqlite:///./admin_portal.db
# PostgreSQL: postgresql://user:pass@localhost:5432/maruti_admin
DATABASE_URL=sqlite:///./admin_portal.db

# Admin credentials (used to seed the DB on first run)
ADMIN_EMAIL=admin@maruti.co.in
ADMIN_PASSWORD=password

# LLM for Integration Mapper (use either OpenAI or Anthropic)
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_MODEL=gpt-4o-mini

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS — add your frontend URL
CORS_ORIGINS=http://localhost:4000,http://localhost:4001,http://127.0.0.1:4001
