# ── Maruti Finance — Admin Portal ────────────────────────────────────────────
# Copy this file to .env and fill in values before running or deploying.
# All variables must be prefixed with VITE_ to be exposed to the browser build.

# Backend API base URL (no trailing slash)
# Local dev:   http://localhost:8000
# Production:  https://api.your-domain.com
VITE_ADMIN_API_URL=http://localhost:8000

# App environment (used for feature flags / logging)
VITE_APP_ENV=development
